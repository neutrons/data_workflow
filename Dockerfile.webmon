# Stage 1: Build wheels
FROM ghcr.io/prefix-dev/pixi:0.69.0-bookworm-slim AS builder

COPY pyproject.toml pixi.lock ./
COPY src/webmon_app  src/webmon_app/
COPY src/workflow_app src/workflow_app/

RUN pixi install --locked -e webmon
RUN pixi run -e webmon wheel-workflow && pixi run -e webmon wheel-webmon

# Stage 2: Runtime image
FROM ghcr.io/prefix-dev/pixi:0.69.0-bookworm-slim

RUN apt update && apt install -y ca-certificates wget tzdata

COPY pixi.lock pyproject.toml ./
RUN pixi install --locked -e webmon

WORKDIR /usr/src/webmon

COPY --from=builder /src/workflow_app/dist/ ./dist/
COPY --from=builder /src/webmon_app/dist/  ./dist/
RUN pixi run -e webmon pip install dist/*.whl && rm -rf dist/

COPY src/webmon_app/docker-entrypoint.sh /usr/bin/docker-entrypoint.sh
RUN chmod +x /usr/bin/docker-entrypoint.sh
CMD ["pixi", "run", "-e", "webmon", "/usr/bin/docker-entrypoint.sh"]
